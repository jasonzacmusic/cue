{
  "name": "cue-browser",
  "productName": "Cue",
  "version": "0.6.17",
  "main": "src/main/main.js",
  "author": "Jason Zac, Nathaniel School of Music",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/jasonzacmusic/cue",
  "scripts": {
    "start": "electron .",
    "test": "CUE_TEST=1 electron .",
    "dist:mac": "node scripts/build-mac.js",
    "dist:win": "node scripts/build-win.js",
    "dist:linux": "node scripts/build-linux.js",
    "check": "node -e \"const{execFileSync}=require('child_process'),fs=require('fs'),path=require('path');const walk=(d)=>fs.readdirSync(d,{withFileTypes:true}).flatMap((e)=>e.isDirectory()?(e.name==='node_modules'?[]:walk(path.join(d,e.name))):e.name.endsWith('.js')?[path.join(d,e.name)]:[]);const files=[...walk('src'),...walk('bin'),...walk('test')];for(const f of files)execFileSync(process.execPath,['--check',f],{stdio:'inherit'});console.log(files.length+' files parse')\""
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/osx-sign": "^2.7.2",
    "@electron/packager": "^20.3.0",
    "electron": "github:castlabs/electron-releases#v44.10.1+wvcus"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "gifenc": "^1.0.3"
  }
}
